DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite é usado quando DATABASE_URL não está definida.
# Para PostgreSQL, remova o comentário e ajuste os valores:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/inscricoes

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173