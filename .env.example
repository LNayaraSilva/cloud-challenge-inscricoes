# Variáveis da automação de testes Playwright (copie para .env na raiz).
# O backend Django continua usando backend/.env (ver backend/.env.example).

# --- Execução local (padrão) -------------------------------------------
# Deixe BASE_URL vazia: o Playwright sobe o Django em 127.0.0.1:E2E_PORT
# com um banco SQLite descartável (tests/.e2e/e2e-<porta>.sqlite3) e cria um
# organizador temporário com senha aleatória.
E2E_PORT=8010
# Caminho do Python com as dependências do backend.
# Padrão: backend/.venv (se existir) ou "python" do PATH.
PYTHON_BIN=

# --- Execução contra ambiente externo (homologação) --------------------
# Ao preencher BASE_URL, o servidor local NÃO é iniciado.
# Os testes CRIAM eventos e inscrições: não aponte para produção.
BASE_URL=
# Opcional: por padrão é igual a BASE_URL (API e site na mesma origem).
API_BASE_URL=

# Conta Django com is_staff=True e permissões delete_evento/delete_inscricao
# (usadas na limpeza dos dados pelo /admin/). Nunca versione valores reais.
TEST_STAFF_USERNAME=
TEST_STAFF_PASSWORD=

# --- Ajustes de execução -----------------------------------------------
# PW_WORKERS=2
# PW_RETRIES=0
